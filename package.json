{
  "name": "apkstart",
  "productName": "ApkStart",
  "version": "0.4.4",
  "description": "Лёгкий запуск Android-приложений на Linux: двойной клик по APK → установка → отдельное окно приложения (Android Emulator + KVM)",
  "main": "src/main.js",
  "desktopName": "apkstart",
  "author": "RoutineMiku (upstream); Linux fork maintained in this repository",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/RoutineMiku/apkstart#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RoutineMiku/apkstart.git"
  },
  "bugs": {
    "url": "https://github.com/RoutineMiku/apkstart/issues"
  },
  "keywords": [
    "android",
    "apk",
    "linux",
    "electron",
    "adb",
    "emulator",
    "kvm",
    "wayland",
    "xdg"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "linux"
  ],
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node test/run-tests.js && node test/core-test.js && node test/ui-wiring-test.js && node test/engine-test.js && node test/auto-test.js",
    "pack": "node build/pack.js",
    "build:deb": "node build/prepare-runtime.js && electron-builder --linux deb",
    "build:appimage": "node build/prepare-runtime.js && electron-builder --linux AppImage",
    "build:all": "node build/prepare-runtime.js && electron-builder --linux deb AppImage",
    "build:fast": "electron-builder --linux deb AppImage",
    "selftest": "node scripts/selftest.js",
    "assoc:on": "node scripts/assoc.js on",
    "assoc:off": "node scripts/assoc.js off",
    "check:deps": "node tools/check-linux.js",
    "test:coverage": "node test/coverage.js"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@napi-rs/lzma": "^1.5.3"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
